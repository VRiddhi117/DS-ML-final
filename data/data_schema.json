{
  "dataset_name": "Cosmetics Reviews Classification",
  "source": "Amazon / Open-source cosmetics reviews",
  "task_type": "Binary Classification",
  "target": {
    "name": "label",
    "description": "Binary sentiment label derived from rating",
    "mapping": {
      "1": "Positive review (rating >= 4)",
      "0": "Negative review (rating <= 2)"
    }
  },
  "features": [
    {
      "name": "review_text",
      "type": "text",
      "description": "Customer-written review text",
      "used_in_model": true
    },
    {
      "name": "rating",
      "type": "integer",
      "description": "Star rating from 1 to 5",
      "used_in_model": true
    },
    {
      "name": "helpful_votes",
      "type": "integer",
      "description": "Number of helpful votes received",
      "used_in_model": true
    },
    {
      "name": "verified_purchase",
      "type": "boolean",
      "description": "Whether the purchase was verified",
      "used_in_model": true
    }
  ],
  "preprocessing": {
    "text": "TF-IDF Vectorization",
    "numerical": [
      "StandardScaler",
      "MinMaxScaler",
      "LogTransformation"
    ],
    "categorical": "OneHotEncoding"
  },
  "splitting_strategy": {
    "method": "train_test_split",
    "test_size": 0.2,
    "stratify_on": "label"
  },
  "evaluation_metric": "F1-score",
  "notes": "Schema used consistently across training, evaluation, and inference pipelines."
}
